# SkillForge API - environment variables
# Copy this file to .env and fill in real values. NEVER commit the real .env.

# Strong random string, e.g. output of: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# MongoDB connection string (Atlas or local)
MONGO_URI=mongodb://127.0.0.1:27017/skillforge

# Allowed CORS origin of the React client
CLIENT_URL=http://localhost:3000

# HTTP port for the API server
PORT=5000
